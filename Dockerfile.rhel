# RHEL (Red Hat Enterprise Linux) Universal Base Image
FROM registry.access.redhat.com/ubi9/ubi:9.4

LABEL maintainer="pupu" \
      description="RHEL-based Enterprise Neo4j Knowledge Graph & C/COBOL Analyzer"

# Install Python 3.11, OpenJDK 17 (for Neo4j), git, procps with --allowerasing for curl-minimal
RUN dnf -y update && \
    dnf -y install --allowerasing \
        python3.11 \
        python3.11-pip \
        java-17-openjdk-headless \
        curl \
        tar \
        git \
        procps-ng && \
    dnf clean all

# Install Neo4j Community Edition 5.20.0
ENV NEO4J_HOME=/var/lib/neo4j
ENV PATH=$NEO4J_HOME/bin:$PATH
ENV NEO4J_AUTH=neo4j/password123

RUN mkdir -p /var/lib/neo4j && \
    curl -fsSL https://dist.neo4j.org/neo4j-community-5.20.0-unix.tar.gz -o /tmp/neo4j.tar.gz && \
    tar -xzf /tmp/neo4j.tar.gz -C /var/lib/neo4j --strip-components=1 && \
    rm -f /tmp/neo4j.tar.gz

# Configure Neo4j to listen on all interfaces (0.0.0.0)
RUN sed -i 's/#server.default_listen_address=0.0.0.0/server.default_listen_address=0.0.0.0/' $NEO4J_HOME/conf/neo4j.conf && \
    sed -i 's/#dbms.security.auth_enabled=false/dbms.security.auth_enabled=true/' $NEO4J_HOME/conf/neo4j.conf

# Set workdir and copy analyzer files
WORKDIR /app
COPY analyzer /app/analyzer
COPY mcp_config.json /app/mcp_config.json
COPY docker-entrypoint.sh /app/docker-entrypoint.sh

RUN chmod +x /app/docker-entrypoint.sh /app/analyzer/scan_repo.py

EXPOSE 7474 7687

ENTRYPOINT ["/app/docker-entrypoint.sh"]
CMD ["neo4j", "console"]
